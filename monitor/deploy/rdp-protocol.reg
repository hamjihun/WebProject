Windows Registry Editor Version 5.00

; IMS memo board - Remote Desktop shortcut tiles (mstsc:192.168.0.9)
; Double-click this file on each PC. Administrator rights are NOT needed.
; Registers the "mstsc:" URL scheme for the current user only.

[HKEY_CURRENT_USER\Software\Classes\mstsc]
@="URL:Remote Desktop"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\mstsc\DefaultIcon]
@="C:\\Windows\\System32\\mstsc.exe,0"

[HKEY_CURRENT_USER\Software\Classes\mstsc\shell\open\command]
@="powershell.exe -NoProfile -WindowStyle Hidden -Command \"$u = '%1' -replace '^mstsc:/*','' -replace '/+$',''; if ($u -match '^[A-Za-z0-9._-]+(:[0-9]{1,5})?$') { Start-Process mstsc.exe -ArgumentList ('/v:' + $u) }\""
