<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS: /monitor/ 경로로 수집기를 노출
  필요: URL Rewrite 모듈 + Application Request Routing(ARR) 설치 후
        IIS 관리자 > 서버 > Application Request Routing Cache > Server Proxy Settings > Enable proxy 체크
  이 파일 내용을 IMS 사이트의 web.config <system.webServer> 안 <rewrite> 에 병합
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ServerMonitorProxy" stopProcessing="true">
          <match url="^monitor/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8787/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_REAL_IP" value="{REMOTE_ADDR}" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
