{
  "usb": {
    "label": "프로그램USB",
    "appFolder": "【 Application 】"
  },
  "network": {
    "ip": "192.168.",
    "subnet": "255.255.255.0",
    "dns1": "168.126.63.1"
  },
  "install": {
    "parallel": true,
    "staggerSeconds": 30
  },
  "programs": [
    {
      "name": "오피스",
      "find": [
        "1.OfficeSetup.exe",
        "*OfficeSetup*.exe"
      ],
      "args": "",
      "installed": [
        "%ProgramFiles%\\Microsoft Office\\root\\Office1*\\EXCEL.EXE",
        "%ProgramFiles(x86)%\\Microsoft Office\\root\\Office1*\\EXCEL.EXE",
        "%ProgramFiles%\\Microsoft Office\\Office1*\\EXCEL.EXE",
        "%ProgramFiles(x86)%\\Microsoft Office\\Office1*\\EXCEL.EXE"
      ],
      "guide": "설치 창이 뜨면 그대로 진행하세요.\n설치가 끝날 때까지 기다리면 됩니다."
    },
    {
      "name": "반디집",
      "find": [
        "*BANDIZIP*SETUP*.exe",
        "*bandizip*.exe",
        "*반디집*.exe"
      ],
      "args": "",
      "installed": [
        "%ProgramFiles%\\Bandizip\\Bandizip.exe"
      ],
      "guide": "자동으로 진행합니다. 마우스/키보드를 건드리지 마세요.\n  '사용 통계 및 오류 보고서 자동 전송' 체크 해제\n  → [동의 및 설치] → [닫기] → [지금 적용] → [확인]\n\n자동 진행이 멈추면 위 순서대로 직접 진행한 뒤\n이 창의 [완료] 를 누르세요.",
      "auto": [
        {
          "uncheck": "*통계*|*오류 보고*",
          "click": "동의 및 설치*|*동의*설치*",
          "timeout": 120
        },
        {
          "click": "닫기*|Close*",
          "timeout": 300
        },
        {
          "click": "지금 적용*",
          "timeout": 60
        },
        {
          "click": "확인*|OK",
          "timeout": 60,
          "optional": true
        }
      ],
      "confirmAfter": true
    },
    {
      "name": "크롬",
      "find": [
        "*ChromeSetup*.exe",
        "*chrome*.msi",
        "*chrome*.exe"
      ],
      "args": "/silent /install",
      "installed": [
        "%ProgramFiles%\\Google\\Chrome\\Application\\chrome.exe",
        "%ProgramFiles(x86)%\\Google\\Chrome\\Application\\chrome.exe"
      ]
    },
    {
      "name": "카카오톡",
      "find": [
        "*KakaoTalk*Setup*.exe",
        "*kakaotalk*.exe",
        "*카카오톡*.exe"
      ],
      "args": "",
      "installed": [
        "%ProgramFiles(x86)%\\Kakao\\KakaoTalk\\KakaoTalk.exe",
        "%ProgramFiles%\\Kakao\\KakaoTalk\\KakaoTalk.exe"
      ],
      "guide": "자동으로 진행합니다. 마우스/키보드를 건드리지 마세요.\n  [다음] → [다음] → 'Daum을 시작페이지로 설정' 체크 해제\n  → 설치\n\n자동 진행이 멈추면 위 순서대로 직접 진행하세요.",
      "auto": [
        {
          "uncheck": "*Daum*|*시작페이지*|*시작 페이지*",
          "click": "설치*|Install*",
          "alsoClick": "다음*|Next*|동의*|I Agree*",
          "timeout": 180
        },
        {
          "click": "마침*|Finish*|닫기*|완료*",
          "timeout": 300,
          "optional": true
        }
      ]
    },
    {
      "name": "Adobe Reader",
      "find": [
        "Reader_kr_install.exe",
        "*Reader*install*.exe",
        "*acro*.exe"
      ],
      "args": "",
      "installed": [
        "%ProgramFiles%\\Adobe\\Acrobat DC\\Acrobat\\Acrobat.exe",
        "%ProgramFiles(x86)%\\Adobe\\Acrobat Reader DC\\Reader\\AcroRd32.exe",
        "%ProgramFiles%\\Adobe\\Acrobat Reader DC\\Reader\\AcroRd32.exe"
      ],
      "guide": "설치 창이 뜨면 그대로 진행하세요.\n(인터넷으로 내려받아 설치하므로 몇 분 걸릴 수 있습니다)"
    },
    {
      "name": "V3",
      "find": [
        "*EPP_AgentSetup*.exe",
        "*EPP*Agent*.exe",
        "*v3*.exe",
        "*ahnlab*.exe"
      ],
      "args": "",
      "installed": [
        "%ProgramFiles%\\AhnLab\\*",
        "%ProgramFiles(x86)%\\AhnLab\\*"
      ],
      "guide": "설치 창이 뜨면 그대로 진행하세요."
    },
    {
      "name": "ERP",
      "find": [
        "*ERP*KSystem*.exe",
        "*ERP*.exe"
      ],
      "args": "",
      "guide": "자동으로 진행합니다. 마우스/키보드를 건드리지 마세요.\n  [다음] → [Finish] → Client Update 에 {erpServer} 입력 → [다음]\n\n자동 진행이 멈추면 직접 진행하세요.\n(서버 주소는 복사되어 있으니 Ctrl+V)\n모두 끝나면 이 창의 [완료] 를 누르세요.",
      "auto": [
        {
          "click": "Finish*|마침*|완료*",
          "alsoClick": "다음*|Next*",
          "timeout": 300
        },
        {
          "setText": "{erpServer}",
          "click": "다음*|Next*",
          "timeout": 180
        }
      ],
      "confirmAfter": true,
      "clipboard": "{erpServer}"
    }
  ],
  "fonts": {
    "folder": "2. font\\LG스마트체",
    "search": "LG스마트체"
  },
  "taskbar": {
    "search": "icon",
    "hideWidgets": true,
    "unpin": [
      "메일",
      "Mail",
      "Microsoft Store",
      "*Bandizip*",
      "*반디집*"
    ]
  },
  "desktopIcons": [
    "computer",
    "userFiles",
    "network",
    "recycleBin",
    "controlPanel"
  ],
  "misc": {
    "showFileExtensions": true
  },
  "power": {
    "plan": "",
    "monitorTimeoutAC": 60,
    "monitorTimeoutDC": 60,
    "sleepTimeoutAC": 0,
    "sleepTimeoutDC": 0,
    "lidCloseAC": "nothing",
    "lidCloseDC": "nothing",
    "lidOnlyLaptop": true,
    "disableHibernate": false
  },
  "browser": {
    "updateFirst": true,
    "chromeExtensions": [
      "mhocmmnceidnldpneiioaglmmgkhhmgh"
    ],
    "edgeExtensions": [
      "nijboebkfeipcfjoohpkloahghaidpaj"
    ],
    "enforceSettings": false
  },
  "printer": {
    "driverFolder": "5. IV C2263N(김해2F 1.133, 1F 1.11 부산0.7)\\C3060드라이버",
    "search": "*C3060*",
    "driverName": "",
    "driverHint": "C3060",
    "namePrefix": "IV C2263N",
    "printers": [
      {
        "name": "부산",
        "ip": "192.168.0.7"
      },
      {
        "name": "김해 2F",
        "ip": "192.168.1.133"
      },
      {
        "name": "김해 1F",
        "ip": "192.168.1.11"
      }
    ]
  },
  "docCentral": {
    "path": "8.문서중앙화.exe",
    "find": [
      "*문서중앙화*.exe"
    ],
    "args": "",
    "guide": "설치 창이 뜨면 그대로 진행하세요.\n재부팅하라고 뜨면 [확인(OK)] 을 누르세요.\n재부팅 후 로그인하면 남은 작업을 자동으로 이어서 진행합니다."
  },
  "drivers": {
    "localFolder": "drivers",
    "useVendorTool": true,
    "windowsUpdate": true
  },
  "sites": [
    {
      "name": "부산",
      "erpServer": "192.168.0.252:8080",
      "printers": [
        "부산"
      ]
    },
    {
      "name": "김해",
      "erpServer": "192.168.1.250:8080",
      "printers": []
    }
  ],
  "windowsUpdate": {
    "maxRounds": 6
  }
}